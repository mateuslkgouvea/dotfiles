{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "battery",
    "tray"
  ],
  "custom/menu": {
    "format": "  󰣇  ",
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/menu.xml",
    "menu-actions": {
      "entry1": "alacritty --class float-helper -e arch-install --aur",
      "entry2": "alacritty --class float-helper -e  arch-install --pacman",
      "entry3": "alacritty --class float-helper -e webapp-install"
    }
  },
  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 5,
    "on-click": "alacritty --class float-helper-big -e btop"
  },
  "memory": {
    "format": "  {}%",
    "interval": 5,
    "on-click": "alacritty --class float-helper-big -e btop"
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": " off",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "on-click": "alacritty --class float-helper -e bluetuith"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ipaddr}",
    "on-click": "alacritty --class float-helper -e impala"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  Muted"
  },
  "battery": {
    "format": "  {capacity}%",
    "format-charging": " {capacity}%"
  },
  "tray": {
    "spacing": 10
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Zen Browser": "  $1",
      "(.*) - Chromium": "  $1",
      "(.*) on QEMU/KVM": "  $1",
      "Spotify Premium": "󰓇 ",
      "web.whatsapp.com": "󰖣 ",
      "nvim": " ",
      "tmux": " ",
      "alacritty": " "
    },
    "separate-outputs": true
  }
}
