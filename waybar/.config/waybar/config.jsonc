{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "bluetooth", "network", "cpu", "memory", "battery", "tray"],

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 5, 
    "on-click": "kitty btop"
  },

  "memory": {
    "format": "  {}%",
    "interval": 5
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": " off",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "on-click": "kitty --class float-helper bluetuith"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ipaddr}",
    "on-click": "kitty --class float-helper impala"
  },

  "pulseaudio": {
  "format": "  {volume}%",
    "format-muted": "  Muted"
  },

  "battery": {
    "format": "  {capacity}%",
    "format-charging": " {capacity}%"
  },

  "tray": {
    "spacing": 10
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Zen Browser": "  $1",
      "(.*) - Chromium": "  $1",
      "(.*) on QEMU/KVM": "  $1",
      "Spotify Premium":"󰓇 ",
      "web.whatsapp.com":"󰖣 ",
      "nvim": " ",
      "tmux": " ",
    },
  "separate-outputs": true
  }
}

